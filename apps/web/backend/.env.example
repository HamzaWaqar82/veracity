DATABASE_URL="postgresql://user:pass@localhost:5432/veracity" # pragma: allowlist secret
OPENROUTER_API_KEY="sk-or-..." # pragma: allowlist secret
LANGSMITH_API_KEY="lsv2_..." # pragma: allowlist secret

# LLM providers (chat + eval judge). Ordered, comma-separated: the backend
# rotates through each provider's model chain in this order. Default: Gemini
# first (generous free tier), OpenRouter free models as fallback.
LLM_PROVIDERS="gemini,openrouter"

# Google Gemini (free tier, ~1500 RPD). Get a key at https://aistudio.google.com
GEMINI_API_KEY="" # pragma: allowlist secret
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODELS="gemini-3.5-flash-lite"

# Observability (all optional; defaults shown):
# VERACITY_LOG_LEVEL  - DEBUG / INFO / WARNING / ERROR          (default INFO)
# VERACITY_LOG_FORMAT - "json" for structured JSON lines, "text" for plain
VERACITY_LOG_LEVEL="INFO"
VERACITY_LOG_FORMAT="json"
# VERACITY_LOG_FILE  - where rotating logs go (default backend/../logs/backend.log)
# VERACITY_LOG_HTTP  - "1" to also log raw httpx HTTP traffic
